{
  "name": "aura",
  "version": "1.0.0",
  "description": "Aura is a social media platform that allows users to share their thoughts, ideas, and experiences with others. It provides a space for users to connect, engage, and express themselves through posts, comments, and likes.",
  "main": "index.ts",
  "scripts": {
    "start": "tsc && node --env-file=../.env.development ./dist/src/server.js",
    "dev": "nodemon --exec \"node --env-file=../.env.development -r ts-node/register\" ./src/server.ts",
    "seed": "ts-node ./src/seed.ts",
    "test": "tsc && jest --runInBand --detectOpenHandles --forceExit",
    "testComment": "tsc && jest --runInBand --detectOpenHandles --forceExit ./src/tests/comments.test.ts",
    "testPost": "tsc && jest --runInBand --detectOpenHandles --forceExit ./src/tests/posts.test.ts",
    "testAuth": "tsc && jest --runInBand --detectOpenHandles --forceExit ./src/tests/auth.test.ts",
    "testLike": "tsc && jest --runInBand --detectOpenHandles --forceExit ./src/tests/likes.test.ts",
    "jestCoverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LironDabach/Aura.git"
  },
  "author": "Shiran Levi and Liron Dabach",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LironDabach/Aura/issues"
  },
  "homepage": "https://github.com/LironDabach/Aura#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
